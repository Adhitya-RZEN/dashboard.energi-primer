# Existing PostgreSQL connection. This file contains no credentials.
DATABASE_URL="postgresql://127.0.0.1:5432/dashboard_pln"

# Phase 21 operator-only preflight targets. Do not use these as the app
# DATABASE_URL until the approved cutover gate is completed.
SUPABASE_DIRECT_URL=""
SUPABASE_POOLER_URL=""

# Public, non-secret application configuration.
NEXT_PUBLIC_APP_NAME="Energi Primer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dashboard source: use `postgres` after the normalized import/parity gate.
# `google` preserves the legacy direct-read path during transition.
DASHBOARD_DATA_SOURCE="postgres"

# Auth.js v5. Generate a unique random value for each deployment.
AUTH_SECRET="replace-with-a-unique-random-secret"
AUTH_TRUST_HOST="true"

# Vercel Cron / sync endpoint secret. Keep this server-side and configure it in Vercel.
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Optional canonical HTTPS origin used by Auth.js deployment configuration.
AUTH_URL="https://your-production-domain.example"

# Optional server-only Google Sheets source for Overview parity with Laravel.
# Keep the service-account JSON outside public/ and never prefix these with NEXT_PUBLIC_.
GOOGLE_SHEETS_CREDENTIALS_PATH="./credentials/service-account.json"
# Alternative for Vercel/serverless: use both variables instead of the local JSON path.
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@example.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="replace-with-server-side-private-key"
GOOGLE_SHEETS_SPREADSHEET_ID="replace-with-server-side-spreadsheet-id"
GOOGLE_SHEETS_CACHE_TTL="120"
